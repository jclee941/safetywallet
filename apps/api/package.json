{
  "name": "@safetywallet/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:inspect": "wrangler dev --inspector-port 9229",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir=dist --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "deploy": "node -e \"console.error('Manual deploy is disabled. Deployment is controlled by GitHub Actions + Cloudflare Git Integration (git-ref based).'); process.exit(1)\"",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply safetywallet-db --local --config wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply safetywallet-db --remote --env=\"\" --config wrangler.toml",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@safetywallet/types": "*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "jose": "^6.2.9",
    "jpeg-js": "^0.4.4",
    "mysql2": "^3.23.3",
    "piexifjs": "^1.0.6",
    "sql.js": "^1.14.2",
    "yaml": "^2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260626.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  }
}
