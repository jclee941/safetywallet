{
  "name": "@safetywallet/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir=dist --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "deploy": "node -e \"console.error('Manual deploy is disabled. Deployment is controlled by GitLab CI (git-ref based).'); process.exit(1)\"",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply safetywallet-db --local --config wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply safetywallet-db --remote --env=\"\" --config wrangler.toml",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@safetywallet/types": "*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.10",
    "jose": "^6.2.0",
    "jpeg-js": "^0.4.4",
    "mysql2": "^3.19.0",
    "piexifjs": "^1.0.6",
    "sql.js": "^1.14.1",
    "yaml": "^2.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260307.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.7.3",
    "wrangler": "^4.71.0"
  }
}
