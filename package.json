{
  "name": "safetywallet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "eslint": "^8.57.0",
    "serialize-javascript": ">=7.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build && npm run build:static",
    "build:api": "npm run build --workspace=packages/types && npm run build --workspace=apps/api",
    "build:static": "rm -rf dist && mkdir -p dist/admin && cp -r apps/worker/out/* dist/ && cp -r apps/admin/out/* dist/admin/",
    "build:one-worker": "npm run build:api",
    "dev": "turbo run dev",
    "deploy:api": "node -e \"console.error('Manual deploy is disabled. Deploy is Git-ref driven via CI on master.'); process.exit(1)\"",
    "lint": "turbo run lint",
    "lint:naming": "node scripts/lint-naming.js",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "check:wrangler-sync": "node scripts/check-wrangler-sync.js",
    "git:preflight": "go run scripts/git-preflight.go",
    "verify": "go run scripts/verify.go",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "prepare": "husky",
    "e2e": "op run --env-file=.env.e2e -- npx playwright test",
    "e2e:headed": "op run --env-file=.env.e2e -- npx playwright test --headed",
    "e2e:ui": "op run --env-file=.env.e2e -- npx playwright test --ui"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "go run scripts/check-anti-patterns.go",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.110.0"
  }
}
